# Copia questo file in ".env" (che NON va committato) e compila i valori.
# Dispositivi e sensori non stanno qui: sono in data/devices.json e data/sensors.json.

# --- Home Assistant ---
# Profilo utente -> Sicurezza -> Token di accesso a lunga durata
HA_TOKEN=
HA_URL=http://IP_HA:8123/api
# Entità meteo usata da agenda e dashboard Kindle
#WEATHER_ENTITY_ID=

# --- Google Calendar (agenda) ---
CALENDAR_ID=

# --- Synology Photos (dashboard Kindle) ---
# URL base del DSM, SENZA /webapi
SYNO_URL=
# Consigliato: utente dedicato, sola lettura sull'album foto, SENZA 2FA
SYNO_ACCOUNT=
SYNO_PASSWORD=

# --- Opzionali (hanno già un default) ---
#PORT=8085
#REFRESH_MINUTES_CALENDAR=5
#REFRESH_MINUTES_BIRTHDAY=5
#REFRESH_MINUTES_DASHBOARD=15
#PHOTO_EVERY_N_REFRESH=1             # nuova foto ogni N rigenerazioni
